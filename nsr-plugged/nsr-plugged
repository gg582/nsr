#!/usr/bin/env python3
import os
import sys
import shutil
import argparse
import subprocess

NSR_DIR = os.path.expanduser("~/.nsr")
PLUGINS_DIR = os.path.join(NSR_DIR, "plugins")
CONFIG_PATH = os.path.expanduser("~/.nsrconfig")

# Colors for terminal output
GREEN = "\033[92m"
YELLOW = "\033[93m"
RED = "\033[91m"
BLUE = "\033[94m"
RESET = "\033[0m"
BOLD = "\033[1m"

def get_installed_plugins():
    if not os.path.exists(PLUGINS_DIR):
        return []
    plugins = []
    for f in os.listdir(PLUGINS_DIR):
        full_path = os.path.join(PLUGINS_DIR, f)
        # Executables or scripts
        if os.path.isfile(full_path) and os.access(full_path, os.X_OK):
            plugins.append(f)
    return sorted(plugins)

def read_config():
    config = {}
    if os.path.exists(CONFIG_PATH):
        with open(CONFIG_PATH, "r") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                config[k.strip()] = v.strip()
    return config

def write_config(config):
    # We update existing config without losing unrelated lines
    lines = []
    updated_keys = set()
    
    if os.path.exists(CONFIG_PATH):
        with open(CONFIG_PATH, "r") as f:
            for line in f:
                stripped = line.strip()
                if stripped and not stripped.startswith("#") and "=" in stripped:
                    k, _ = stripped.split("=", 1)
                    k = k.strip()
                    if k in config:
                        lines.append(f"{k}={config[k]}\n")
                        updated_keys.add(k)
                        continue
                lines.append(line)
                
    # Add new keys
    for k, v in config.items():
        if k not in updated_keys:
            lines.append(f"{k}={v}\n")
            
    with open(CONFIG_PATH, "w") as f:
        f.writelines(lines)

def is_plugin_enabled(name, config):
    key = f"NSR_PLUGIN_{name}"
    return config.get(key) == "1"

def cmd_list(args):
    plugins = get_installed_plugins()
    config = read_config()
    
    print(f"{BOLD}NSR Installed Plugins:{RESET}")
    if not plugins:
        print("  No plugins installed.")
        return
        
    for p in plugins:
        enabled = is_plugin_enabled(p, config)
        status = f"{GREEN}[Active]{RESET}" if enabled else f"{RED}[Inactive]{RESET}"
        print(f"  {BOLD}{p:<15}{RESET} {status}")

def cmd_enable(args):
    name = args.name
    plugins = get_installed_plugins()
    if name not in plugins:
        print(f"{YELLOW}Warning: Plugin '{name}' is not installed in {PLUGINS_DIR}, enabling it anyway.{RESET}")
        
    config = read_config()
    config[f"NSR_PLUGIN_{name}"] = "1"
    write_config(config)
    print(f"{GREEN}Enabled plugin: {BOLD}{name}{RESET}")

def cmd_disable(args):
    name = args.name
    config = read_config()
    config[f"NSR_PLUGIN_{name}"] = "0"
    write_config(config)
    print(f"{GREEN}Disabled plugin: {BOLD}{name}{RESET}")

def cmd_install(args):
    path = args.path
    if not os.path.exists(path):
        print(f"{RED}Error: Path '{path}' does not exist.{RESET}")
        sys.exit(1)
        
    if os.path.isdir(path):
        # Look for Makefile
        makefile = os.path.join(path, "Makefile")
        if os.path.exists(makefile):
            print(f"{BLUE}Running 'make install' in {path}...{RESET}")
            res = subprocess.run(["make", "install"], cwd=path)
            if res.returncode == 0:
                print(f"{GREEN}Successfully installed plugin from {path}.{RESET}")
            else:
                print(f"{RED}Error: 'make install' failed with exit code {res.returncode}.{RESET}")
                sys.exit(1)
        else:
            # Try to copy files
            print(f"{YELLOW}No Makefile found. Attempting custom copy...{RESET}")
            # Ask to copy files
            files = os.listdir(path)
            scripts = [f for f in files if f.endswith(".py") or f.endswith(".sh")]
            if not scripts:
                print(f"{RED}Error: No script or Makefile found in {path}.{RESET}")
                sys.exit(1)
                
            os.makedirs(PLUGINS_DIR, exist_ok=True)
            for s in scripts:
                dest = os.path.join(PLUGINS_DIR, os.path.splitext(s)[0])
                shutil.copy(os.path.join(path, s), dest)
                os.chmod(dest, 0o755)
                print(f"{GREEN}Copied {s} to {dest}{RESET}")
    else:
        # Single file
        os.makedirs(PLUGINS_DIR, exist_ok=True)
        filename = os.path.basename(path)
        name = os.path.splitext(filename)[0]
        dest = os.path.join(PLUGINS_DIR, name)
        shutil.copy(path, dest)
        os.chmod(dest, 0o755)
        print(f"{GREEN}Installed file {filename} as plugin {name} to {dest}{RESET}")

def cmd_uninstall(args):
    name = args.name
    plugin_path = os.path.join(PLUGINS_DIR, name)
    if os.path.exists(plugin_path):
        os.remove(plugin_path)
        print(f"{GREEN}Removed plugin binary: {plugin_path}{RESET}")
    else:
        print(f"{YELLOW}Warning: Plugin binary '{name}' not found in {PLUGINS_DIR}.{RESET}")
        
    config = read_config()
    key = f"NSR_PLUGIN_{name}"
    if key in config:
        config[key] = "0"
        write_config(config)
        print(f"{GREEN}Disabled '{name}' in config.{RESET}")

def cmd_create(args):
    name = args.name
    workspace_root = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
    template_dir = os.path.join(workspace_root, "template-nsr-plugin-python")
    target_dir = os.path.join(workspace_root, "plugins", name)
    
    if not os.path.exists(template_dir):
        print(f"{RED}Error: Template directory '{template_dir}' not found.{RESET}")
        sys.exit(1)
        
    if os.path.exists(target_dir):
        print(f"{RED}Error: Target directory '{target_dir}' already exists.{RESET}")
        sys.exit(1)
        
    print(f"{BLUE}Creating new plugin '{name}' in monorepo under 'plugins/{name}'...{RESET}")
    shutil.copytree(template_dir, target_dir)
    
    # Update Makefile in the new plugin directory to set the correct PLUGIN_NAME
    makefile_path = os.path.join(target_dir, "Makefile")
    if os.path.exists(makefile_path):
        with open(makefile_path, "r") as f:
            content = f.read()
        content = content.replace("PLUGIN_NAME = myplugin", f"PLUGIN_NAME = {name}")
        with open(makefile_path, "w") as f:
            f.write(content)
            
    print(f"{GREEN}Plugin '{name}' created successfully at plugins/{name}!{RESET}")
    print(f"To install it, run: {BOLD}nsr-plugged install plugins/{name}{RESET}")

def main():
    parser = argparse.ArgumentParser(
        description=f"{BOLD}nsr-plugged{RESET} - Plugin Manager for NSR (Net muShRoom)",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    
    # List command
    subparsers.add_parser("list", help="List all installed plugins and their statuses")
    
    # Enable command
    parser_enable = subparsers.add_parser("enable", help="Enable a plugin")
    parser_enable.add_argument("name", help="Name of the plugin to enable")
    
    # Disable command
    parser_disable = subparsers.add_parser("disable", help="Disable a plugin")
    parser_disable.add_argument("name", help="Name of the plugin to disable")
    
    # Install command
    parser_install = subparsers.add_parser("install", help="Install a plugin from folder or file")
    parser_install.add_argument("path", help="Path to the plugin directory or script")
    
    # Uninstall command
    parser_uninstall = subparsers.add_parser("uninstall", help="Uninstall a plugin")
    parser_uninstall.add_argument("name", help="Name of the plugin to uninstall")
    
    # Create command
    parser_create = subparsers.add_parser("create", help="Create a new Python plugin from template")
    parser_create.add_argument("name", help="Name of the new plugin")
    
    args = parser.parse_args()
    
    if args.command == "list":
        cmd_list(args)
    elif args.command == "enable":
        cmd_enable(args)
    elif args.command == "disable":
        cmd_disable(args)
    elif args.command == "install":
        cmd_install(args)
    elif args.command == "uninstall":
        cmd_uninstall(args)
    elif args.command == "create":
        cmd_create(args)

if __name__ == "__main__":
    main()
